{
  // SCND: static assets, with the Worker in src/worker.js running first on every request so it can
  // rate-limit. run_worker_first means every request is a Worker request (Free plan: 100,000 a day),
  // see docs/RATE-LIMITING.md.
  "name": "scnd",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 100 requests per 10 seconds per visitor. One page load is about 12 requests. The limit is loose on purpose:
  // many Philippine mobile users share one public IP behind carrier-grade NAT.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 10 }
    }
  ],
  "preview_urls": true
}
