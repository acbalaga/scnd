{
  // SCND: static assets, with the Worker in src/worker.js running first on every request so it can
  // rate-limit. run_worker_first means every request is a Worker request (Free plan: 100,000 a day),
  // see docs/RATE-LIMITING.md.
  "name": "scnd",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 100 requests per 10 seconds per visitor. One page load is about 12 requests. The limit is loose on purpose:
  // many Philippine mobile users share one public IP behind carrier-grade NAT.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 10 }
    }
  ],
  // Per-version preview URLs off now that the site is live on myscnd.app (Fred, 2 Oct 2026). Preview URLs bypass
  // the custom domain and are an extra public surface. workers_dev is left at its default (on) because beta
  // testers still use scnd.<account>.workers.dev. Set "workers_dev": false when beta ends.
  "preview_urls": false,
  // Production custom domain, bought in Cloudflare 2 Oct 2026. Cloudflare creates the DNS record and certificate.
  // See docs/CUSTOM-DOMAIN.md.
  "routes": [{ "pattern": "myscnd.app", "custom_domain": true }]
}
