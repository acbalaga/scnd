{
  // SCND: static assets only. Cloudflare serves public/ straight from its asset server; no Worker script runs (ticket #37,
  // Fred, 14 Nov 2026). Static asset requests are free and unlimited, so there is no daily request cap to run out of.
  // Security headers, the CSP included, come from public/_headers. The old Worker (rate limiter and headers) is in git
  // history, last at commit fb8fc5a. A Worker may come back only to proxy a public data source (CLAUDE.md rule 2).
  "name": "scnd",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    // Unknown paths get public/404.html (status 404) instead of an empty body (audit M-6).
    "not_found_handling": "404-page"
  },
  // Per-version preview URLs off now that the site is live on myscnd.app (Fred, 2 Oct 2026). Preview URLs bypass
  // the custom domain and are an extra public surface.
  "preview_urls": false,
  // The scnd.<account>.workers.dev address is off: beta ended and the site lives on myscnd.app (Fred, 2 Oct 2026).
  // To bring workers.dev back, remove this line (the default is on).
  "workers_dev": false,
  // Production custom domain, bought in Cloudflare 2 Oct 2026. Cloudflare creates the DNS record and certificate.
  // See docs/CUSTOM-DOMAIN.md.
  "routes": [{ "pattern": "myscnd.app", "custom_domain": true }]
}
