{
  // SCND: static assets first. The script in src/worker.js only runs for
  // paths that are not files in /public (currently just /api/pvgis for spike 2).
  "name": "scnd",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "preview_urls": true
}
